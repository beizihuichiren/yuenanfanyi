# =========================================
# 短剧越南语转译流水线 - 环境变量配置模板
# =========================================
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按需修改下面的值
#   3. 启动：docker compose up -d --build

# ---- Web 服务端口 ----
WEB_PORT=5000

# ---- ASR（语音识别）后端 ----
# 可选值：funasr / whisper / openai_api
# - funasr:    阿里达摩院 Paraformer，中文准确率最高（推荐）
# - whisper:   faster-whisper，多语言，支持 small/medium/large-v3
# - openai_api: OpenAI 兼容 Whisper API（备用）
ASR_BACKEND=funasr

# Whisper 模型大小（仅 ASR_BACKEND=whisper 时生效）
# 可选值：tiny / base / small / medium / large-v3
WHISPER_MODEL_SIZE=large-v3

# ---- 翻译 / AI 纠错 API（DeepSeek）----
# DeepSeek API 国内可直连，无需代理
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ---- 代理（可选，仅当需要访问 OpenAI/HuggingFace 时配置）----
# DeepSeek 国内可直连，留空即可
# 如需走代理，填入代理地址，例如 http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=

# =========================================
# 以下变量通常无需修改（Dockerfile/compose 已配好默认值）
# =========================================
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe
# UPLOAD_DIR=/app/output/uploads
# OUTPUT_DIR=/app/output
# MODELSCOPE_CACHE=/app/modelscope_cache

# ---- 并发配置（按硬件调整）----
# 流水线并发数：RTX 3080 20GB 推荐 2，4090 24GB 可试 3，无 GPU 用 1
PIPELINE_MAX_WORKERS=2
# 消字幕并发数：单实例占 4-6GB 显存，20GB 显存推荐 2，16GB 用 1
SUBTITLE_REMOVE_MAX_CONCURRENCY=2
# 消字幕提前启动（与转写并行）：20GB+ 显存 true 省 5 分钟/集，6-8GB 显存 false
SUBTITLE_EARLY_START=true

# ---- 宿主机 output 目录绝对路径（D-in-D 消字幕必需）----
# 必须与 docker-compose.yml 中 ./output 挂载的宿主机路径一致
# Windows 用正斜杠，如 C:/Users/xxx/project/output
# Linux/macOS 用普通路径，如 /home/xxx/project/output
HOST_OUTPUT_DIR=
